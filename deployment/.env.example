# Copy to .env.dev / .env.prod on the machine that runs scripts/deploy.sh.
# These files hold real hostnames and credentials and are gitignored.

# ---- image registry ----
# Insecure HTTP registry: both this machine and the target need
# "insecure-registries": ["192.168.1.248:5000"] in their Docker daemon config.
REGISTRY=192.168.1.248:5000
IMAGE_TAG=latest

# ---- deploy target (scripts/deploy.sh ssh's here; never log in by hand) ----
SSH_USER=wliant
DEPLOY_HOST=192.168.1.248
# dev and prod share this directory; the compose and env filenames differ, and
# the compose project names (ha-todo-dev / ha-todo-prod) keep the stacks apart.
DEPLOY_DIR=/home/wliant/myapps/ha-todo
SSH_PORT=22

# ---- provided database ----
# One role and database per environment: hatodo_dev / hatodo_prod.
DB_URL=jdbc:postgresql://192.168.1.248:5432/hatodo_<env>
DB_USERNAME=hatodo_<env>
DB_PASSWORD=

# ---- published ports on the target host ----
# Only the web service publishes a port. The backend is reachable solely
# same-origin through nginx at /api, so there is no APP_PORT here.
# dev 5987, prod 5986
WEB_PORT=

# ---- session cookie ----
# Must be false over plain HTTP - a Secure cookie is silently dropped by the
# browser on an http:// origin and login stops working. Set true behind HTTPS.
SESSION_COOKIE_SECURE=false

# ---- provided Redis / MinIO (unused today, see docs/adr/0003) ----
# REDIS_HOST=
# REDIS_PORT=6379
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
