# Copy to .env.dev / .env.prod on the machine that runs scripts/deploy.sh.
# These files hold real hostnames and credentials and are gitignored.

# ---- image registry ----
# Insecure HTTP registry: both this machine and the target need
# "insecure-registries": ["192.168.1.248:5000"] in their Docker daemon config.
REGISTRY=192.168.1.248:5000
IMAGE_TAG=latest

# ---- deploy target (scripts/deploy.sh ssh's here; never log in by hand) ----
SSH_USER=wliant
DEPLOY_HOST=192.168.1.248
# dev and prod share this directory; the compose and env filenames differ, and
# the compose project names (ha-todo-dev / ha-todo-prod) keep the stacks apart.
DEPLOY_DIR=/home/wliant/myapps/ha-todo
SSH_PORT=22

# ---- provided database ----
# One role and database per environment: hatodo_dev / hatodo_prod.
DB_URL=jdbc:postgresql://192.168.1.248:5432/hatodo_<env>
DB_USERNAME=hatodo_<env>
DB_PASSWORD=

# ---- published ports on the target host ----
# Only the web service publishes a port. The backend is reachable solely
# same-origin through nginx at /api, so there is no APP_PORT here.
# dev 5987, prod 5986
WEB_PORT=

# ---- admin account ----
# The single admin account, reconciled from these on every app startup, so this
# is also the rotation path: change the password here and redeploy. Never seeded
# into the database and never in git - see docs/adr/0006.
# Changing ADMIN_USERNAME renames the existing admin rather than adding another.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin
# Required. The app refuses to start without it, and scripts/deploy.sh refuses
# earlier than that. It is the only thing protecting the ability to add accounts,
# because household members may be configured to need no password at all.
ADMIN_PASSWORD=

# ---- session cookie ----
# Must be false over plain HTTP - a Secure cookie is silently dropped by the
# browser on an http:// origin and login stops working. Set true behind HTTPS.
SESSION_COOKIE_SECURE=false

# ---- provided object storage ----
# Profile pictures live here, and later the detail field's images. Required:
# the app creates its own bucket at startup and refuses to start without a
# reachable store, because a deployment that looks healthy and silently cannot
# save a picture is worse than one that says so. See docs/adr/0013 and 0021.
#
# Any S3 API will do - SeaweedFS is what runs here, on its S3 port. S3_BUCKET
# is named explicitly, never derived from the active profile: a profile
# misconfiguration is a plausible mistake and it must not be able to put prod's
# images in dev's bucket. Use ha-todo-dev / ha-todo-prod.
S3_ENDPOINT=http://192.168.1.248:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ha-todo-<env>

# ---- recurring items (docs/adr/0025) ----
# The job that makes recurring items appear by itself.
#
# One app instance runs, so it takes no lock and elects no leader. Two
# instances would both run; ux_todo_item_occurrence turns that into logged
# constraint violations rather than duplicate chores, so the failure is noisy
# and harmless - but it is an assumption, and this is where it is written down.
# adr/0003 already notes that in-memory sessions break before this does.
RECURRENCE_ENABLED=true
# Spring cron, read in APP_TIMEZONE. 01:05 is past midnight so "today" has
# turned over, and off the hour so it never shares a minute with anything else.
# QUOTED, and it has to be: scripts/lib/common.sh sources this file as shell, so
# a bare cron expression's spaces are parsed as arguments and the deploy dies on
# this line before it builds anything.
RECURRENCE_CRON="0 5 1 * * *"
# How far back a run will create what it missed. Zero: a chore that was due
# last Tuesday is not worth creating on Friday, it is noise somebody deletes.
RECURRENCE_CATCH_UP_DAYS=0

# The household's zone, and therefore the whole product's: one household has
# one definition of Thursday (docs/adr/0036). It is the zone a recurring item's
# time of day means, the zone the cron expressions are read in, the day a
# calendar event is placed on, and the zone My day is bucketed into - the SPA is
# told it on /api/me and never asks the browser. REQUIRED IN PRACTICE: unset,
# every container image defaults to UTC and "the bins go out at 7pm" is wrong by
# the offset. TZ is set in no compose file.
APP_TIMEZONE=Asia/Singapore

# ---- subscribed calendar feeds (docs/adr/0034, 0035) ----
# Members subscribe a published .ics URL (Google's secret iCal address,
# Outlook's published link) and its events appear on My day. Read-only: nothing
# here authors an event and there is no OAuth.
#
# The poller shares the recurrence job's one-instance assumption above.
CALENDAR_SYNC_ENABLED=true
# QUOTED, for the reason RECURRENCE_CRON is. Every 20 minutes: providers
# regenerate their published .ics on their own schedule, so polling harder buys
# nothing (docs/adr/0034).
CALENDAR_SYNC_CRON="0 7/20 * * * *"
# How much of the calendar is kept. The back figure covers the widest view My
# day can ask for: a month grid reaches 36 days back on the 31st of a month
# that began on a Sunday.
CALENDAR_WINDOW_BACK=45
CALENDAR_WINDOW_FORWARD=90
# A feed quiet for longer than this is called out on My day, because missing
# events nobody is told about is the one failure this feature cannot have.
CALENDAR_STALE_AFTER=PT6H
# LEAVE THIS FALSE. A member pastes the URL this server then fetches, so with
# private hosts allowed the app can be made to GET the insecure registry on
# 192.168.1.248:5000 and hand the response back in the add-a-calendar preview.
# It relaxes the scheme and the port with the host - true means "any http
# address on any port" - because a fixture .ics is served over plain HTTP on an
# ephemeral port. True only locally and in the integration tests. adr/0035.
CALENDAR_ALLOW_PRIVATE_HOSTS=false

# ---- provided Redis (unused today, see docs/adr/0003) ----
# Still deferred. adr/0013 supersedes adr/0003 for MinIO only.
# REDIS_HOST=
# REDIS_PORT=6379
