# Copy to .env.dev / .env.prod on the machine that runs scripts/deploy.sh.
# These files hold real hostnames and credentials and are gitignored.

# ---- image registry ----
# The registry host[:port] images are pushed to and pulled from.
# NOTE: confirm the port - a plain Docker registry usually listens on 5000, and
# an insecure (non-TLS) registry must also be listed under "insecure-registries"
# in the Docker daemon config on both this machine and the target host.
REGISTRY=192.168.1.248:5000
IMAGE_TAG=latest

# ---- deploy target (scripts/deploy.sh ssh's here; never log in by hand) ----
SSH_USER=
DEPLOY_HOST=
DEPLOY_DIR=
SSH_PORT=22

# ---- provided database ----
DB_URL=jdbc:postgresql://db.example.invalid:5432/hatodo
DB_USERNAME=
DB_PASSWORD=

# ---- published ports on the target host ----
APP_PORT=8080
WEB_PORT=80

# ---- session cookie ----
# Must be true wherever the site is served over HTTPS.
SESSION_COOKIE_SECURE=true

# ---- provided Redis / MinIO (unused today, see docs/adr/0003) ----
# REDIS_HOST=
# REDIS_PORT=6379
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
